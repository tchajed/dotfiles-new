{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  "app": {
    "appearance": "system",
    "workspaceInheritWorkingDirectory": false
  },

  "sidebarAppearance": {
    "matchTerminalBackground": true
  },

  "sidebar": {
    "openPullRequestLinksInCmuxBrowser": false,
    "openPortLinksInCmuxBrowser": true
  },

  "browser": {
    "openTerminalLinksInCmuxBrowser": true,
    "interceptTerminalOpenCommandInCmuxBrowser": true,
    "hostsToOpenInEmbeddedBrowser": [
      "localhost",
      "*.localhost",
      "127.0.0.1",
      "::1",
      "0.0.0.0",
      "*.localtest.me"
    ]
  },

  "shortcuts": {
    "bindings": {
      "newWindow": "cmd+opt+shift+ctrl+t",
      "showHideAllWindows": "cmd+'"
    }
  }
}
